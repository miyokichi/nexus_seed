{
  "_comment": [
    "External Agent Runtime configuration. Copy to a2a.json and point",
    "NEXUS_SEED_A2A_CONFIG at it, then set NEXUS_SEED_A2A_ENABLED=true.",
    "A provider is where a Skill runs; a Skill never names an endpoint."
  ],

  "providers": {
    "observer_agent": {
      "type": "a2a",
      "url": "http://127.0.0.1:8801",
      "token_env": "LITTLE_AGENT_TOKEN",
      "poll_interval_seconds": 1,
      "timeout_seconds": 300,
      "trust_level": 0.5,
      "priority": 100,
      "permissions": [],
      "verify_agent_card": true
    },
    "planner_agent": {
      "type": "a2a",
      "url": "http://127.0.0.1:8802",
      "poll_interval_seconds": 1,
      "timeout_seconds": 600
    }
  },

  "bindings": {
    "world_event_interpretation": { "provider": "observer_agent" },
    "project_planning": { "provider": "planner_agent" },
    "work_generation": { "provider": "planner_agent" },
    "work_assignment": { "provider": "planner_agent" },
    "goal_evaluation": { "provider": "planner_agent" }
  },

  "skills": {
    "roots": ["./skills", "~/.nexus_seed/skills"],
    "on_duplicate": "override",
    "strict": false,
    "allowed_permissions": []
  }
}
