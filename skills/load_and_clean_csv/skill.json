{
  "name": "load_and_clean_csv",
  "version": "1",
  "description": "Load a CSV file, apply the stated filter, and resolve missing values into a clean dataset.",
  "capabilities": ["load_and_clean_csv"],
  "input_ports": ["csv_file"],
  "output_ports": ["cleaned_dataframe"],
  "required_permissions": [],
  "instruction": "SKILL.md",
  "enabled": true,
  "output_schema": {
    "type": "object",
    "required": ["path", "row_count", "columns"],
    "properties": {
      "path": {
        "type": "string",
        "description": "Workspace-relative path of the cleaned dataset written by this step."
      },
      "format": { "type": "string", "enum": ["csv", "parquet", "json"] },
      "row_count": { "type": "integer", "minimum": 0 },
      "columns": { "type": "array", "items": { "type": "string" } },
      "dropped_rows": { "type": "integer", "minimum": 0 },
      "filters_applied": { "type": "array", "items": { "type": "string" } },
      "missing_value_policy": { "type": "array", "items": { "type": "string" } },
      "notes": { "type": "array", "items": { "type": "string" } }
    }
  }
}
