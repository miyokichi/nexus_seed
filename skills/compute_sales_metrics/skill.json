{
  "name": "compute_sales_metrics",
  "version": "1",
  "description": "Compute sales metrics over a cleaned dataset and compare them against a baseline period.",
  "capabilities": ["compute_sales_metrics"],
  "input_ports": ["cleaned_dataframe"],
  "output_ports": ["sales_trend_table"],
  "required_permissions": [],
  "instruction": "SKILL.md",
  "enabled": true,
  "output_schema": {
    "type": "object",
    "required": ["path", "period", "metrics"],
    "properties": {
      "path": {
        "type": "string",
        "description": "Workspace-relative path of the trend table written by this step."
      },
      "period": { "type": "string" },
      "baseline_period": { "type": "string" },
      "grain": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
      "dimensions": { "type": "array", "items": { "type": "string" } },
      "row_count": { "type": "integer", "minimum": 0 },
      "metrics": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "value"],
          "properties": {
            "name": { "type": "string" },
            "value": { "type": "number" },
            "baseline_value": { "type": "number" },
            "change_absolute": { "type": "number" },
            "change_percent": { "type": "number" },
            "unit": { "type": "string" }
          }
        }
      },
      "notes": { "type": "array", "items": { "type": "string" } }
    }
  }
}
