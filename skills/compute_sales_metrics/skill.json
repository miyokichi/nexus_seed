{
  "name": "compute_sales_metrics",
  "version": "1",
  "enabled": true,
  "description": "Compute requested sales metrics and period comparisons from a cleaned dataset, producing a reusable trend-table artifact.",
  "instruction": "SKILL.md",
  "capabilities": [
    "compute_sales_metrics"
  ],
  "input_ports": [
    "cleaned_dataframe"
  ],
  "output_ports": [
    "sales_trend_table"
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "artifact_path": {
        "type": "string",
        "minLength": 1
      },
      "metrics_computed": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "comparison_periods": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "grouping_dimensions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string"
      }
    },
    "required": [
      "artifact_path",
      "metrics_computed",
      "comparison_periods",
      "grouping_dimensions",
      "summary"
    ],
    "additionalProperties": false
  }
}
