{
  "name": "world_event_interpretation",
  "version": "1",
  "description": "Interpret an Observation against current World State and propose StateDelta candidates.",
  "capabilities": ["world_event_interpretation"],
  "input_ports": ["observation", "world_state"],
  "output_ports": ["state_delta_candidate"],
  "required_permissions": [],
  "instruction": "SKILL.md",
  "enabled": true,
  "output_schema": {
    "type": "object",
    "required": ["state_delta_candidates"],
    "properties": {
      "state_delta_candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["entity", "attribute", "new_value", "confidence"],
          "properties": {
            "entity": { "type": "string" },
            "attribute": { "type": "string" },
            "old_value": {},
            "new_value": {},
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "reason": { "type": "string" }
          }
        }
      }
    }
  }
}
