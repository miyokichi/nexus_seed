{
  "name": "work_assignment",
  "version": "1",
  "description": "Advise which capability should carry a Work item, as advice rather than a decision.",
  "capabilities": ["work_assignment"],
  "input_ports": ["work_requirement", "capability_inventory"],
  "output_ports": ["work_assignment_advice"],
  "required_permissions": [],
  "instruction": "SKILL.md",
  "enabled": true,
  "output_schema": {
    "type": "object",
    "required": ["assignments"],
    "properties": {
      "assignments": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["work_key", "required_capabilities", "reason"],
          "properties": {
            "work_key": { "type": "string" },
            "required_capabilities": { "type": "array", "items": { "type": "string" } },
            "missing_capabilities": { "type": "array", "items": { "type": "string" } },
            "reason": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
