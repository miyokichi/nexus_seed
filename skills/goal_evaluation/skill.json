{
  "name": "goal_evaluation",
  "version": "1",
  "description": "Judge whether a Goal is satisfied from its criteria, World State and Work results.",
  "capabilities": ["goal_evaluation"],
  "input_ports": ["goal", "world_state", "work_result"],
  "output_ports": ["goal_evaluation"],
  "required_permissions": [],
  "instruction": "SKILL.md",
  "enabled": true,
  "output_schema": {
    "type": "object",
    "required": ["verdict", "reason"],
    "properties": {
      "verdict": { "type": "string", "enum": ["satisfied", "not_satisfied", "unknown"] },
      "reason": { "type": "string" },
      "evidence": { "type": "array", "items": { "type": "string" } },
      "unmet_criteria": { "type": "array", "items": { "type": "string" } },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }
}
