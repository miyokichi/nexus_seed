{
  "name": "perform_causal_analysis",
  "version": "1",
  "enabled": true,
  "description": "Analyze a sales trend table to rank evidence-supported drivers of an observed sales decline without overstating causality.",
  "instruction": "SKILL.md",
  "capabilities": [
    "perform_causal_analysis"
  ],
  "input_ports": [
    "sales_trend_table"
  ],
  "output_ports": [
    "causal_factors_list"
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "factors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "rank": {
              "type": "integer",
              "minimum": 1
            },
            "factor": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "impact": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "rank",
            "factor",
            "evidence",
            "impact",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "summary": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "factors",
      "summary",
      "limitations"
    ],
    "additionalProperties": false
  }
}
