{
  "name": "perform_causal_analysis",
  "version": "1",
  "description": "Isolate and rank the factors that account for a measured change, with the evidence for each.",
  "capabilities": ["perform_causal_analysis"],
  "input_ports": ["sales_trend_table"],
  "output_ports": ["causal_factors_list"],
  "required_permissions": [],
  "instruction": "SKILL.md",
  "enabled": true,
  "output_schema": {
    "type": "object",
    "required": ["factors", "summary"],
    "properties": {
      "summary": { "type": "string" },
      "unexplained_share": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Fraction of the observed change no listed factor accounts for."
      },
      "factors": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["factor", "evidence", "confidence"],
          "properties": {
            "factor": { "type": "string" },
            "dimension": { "type": "string" },
            "evidence": { "type": "array", "items": { "type": "string" } },
            "contribution_percent": { "type": "number" },
            "direction": { "type": "string", "enum": ["increase", "decrease"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      },
      "ruled_out": { "type": "array", "items": { "type": "string" } },
      "notes": { "type": "array", "items": { "type": "string" } }
    }
  }
}
