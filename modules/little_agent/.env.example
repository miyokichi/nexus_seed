OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Use a vision-capable model so the screen_capture skill's images can be read.
LITTLE_AGENT_MODEL=gpt-4.1-mini
LITTLE_AGENT_WORKSPACE=.
LITTLE_AGENT_REQUIRE_CONFIRMATION=true
LITTLE_AGENT_MAX_TOOL_STEPS=5
LITTLE_AGENT_TIMEOUT_SECONDS=60
LITTLE_AGENT_ENABLE_LOGGING=true
LITTLE_AGENT_LOG_DIR=logs

# Files and directories outside the workspace that tools may use.
# Separator: ; on Windows, : elsewhere. Relative entries resolve from the
# workspace. These also bound what this agent may hand to a peer over A2A:
# a writable path can be granted as a peer's workspace (read+write), a readable
# one only as a read-only allowed_path.
# LITTLE_AGENT_READABLE_PATHS=D:\reference
# LITTLE_AGENT_WRITABLE_PATHS=D:\projects\alpha;D:\shared

# Persistent memory. Chat uses it unless started with --no-memory; A2A tasks
# never do. Workspace-level memory.md / profile.md live in the workspace.
LITTLE_AGENT_GLOBAL_MEMORY_PATH=~/.little_agent/memory.md
LITTLE_AGENT_GLOBAL_PROFILE_PATH=~/.little_agent/profile.md
# Distil durable profiles from a chat session when it ends (and on /remember).
LITTLE_AGENT_AUTO_LEARNING=true

# Filesystem task harness (workspace_harness skill).
LITTLE_AGENT_TASKS_DIR=tasks
LITTLE_AGENT_SHARED_DIR=shared
# Port for the project_manager skill's local web viewer.
LITTLE_AGENT_VIEWER_PORT=8765

# Emergency stop hotkey for AI computer operation (pynput GlobalHotKeys format).
# Active only while the agent is acting. Requires pynput (pip install pynput).
LITTLE_AGENT_STOP_HOTKEY=<ctrl>+<alt>+q

# Slash command directories (CLI only)
# Project commands live in {LITTLE_AGENT_WORKSPACE}/commands/*.md by default.
# Global commands are shared across all workspaces.
LITTLE_AGENT_COMMANDS_DIR=commands
LITTLE_AGENT_GLOBAL_COMMANDS_DIR=~/.little_agent/commands

# Skill library. Skills are a runtime resource, not workspace data, so leaving
# this unset does NOT mean "no skills": the library is resolved as
#   1. this setting, when set (honoured even if the path does not exist)
#   2. <workspace>/skills, when that directory exists
#   3. the built-in library shipped inside the installed package
# Set it only to point at a library somewhere else. Relative paths resolve from
# the workspace. A library that yields no skills is warned about at startup.
# LITTLE_AGENT_SKILL_LIBRARY_DIR=

# Agent profiles. Each agent under agents/<name>/ has an agent.json declaring
# which skills and core tools it may use. LITTLE_AGENT_AGENT selects the agent to
# run at startup (overridable by --agent).
LITTLE_AGENT_AGENTS_DIR=agents
LITTLE_AGENT_AGENT=

# A2A (Agent2Agent) delegation via the delegate_task / delegate_tasks core
# tools. Max hand-off depth; 0 disables delegation entirely.
LITTLE_AGENT_MAX_DELEGATION_DEPTH=2

# How many subtasks delegate_tasks runs at the same time. Extra subtasks queue
# behind the running ones.
LITTLE_AGENT_MAX_PARALLEL_DELEGATIONS=4

# Remote A2A peers available to delegate_task, as name=url pairs.
# Any A2A-compliant agent works, not just another Little Agent. A local agents/
# profile name needs no entry here: its A2A server is started on demand.
# LITTLE_AGENT_A2A_PEERS=office=http://127.0.0.1:8801/,research=http://10.0.0.5:9000/

# Shared bearer token for A2A. When set, this agent's server requires it and the
# client sends it to peers. The Agent Card stays public so peers can discover it.
# LITTLE_AGENT_A2A_TOKEN=

# An A2A server has no human to answer confirmation prompts, so tools that need
# confirmation (write_file, run_powershell, ...) are denied unless this is true.
LITTLE_AGENT_A2A_AUTO_APPROVE=false

# A caller may ask a served agent to work in a given directory (workspace,
# read+write) and to read paths outside it (allowed_paths, read only). Each is
# checked against the matching half of this server's own configuration -- the
# workspace against WRITABLE_PATHS, the allowed paths against READABLE_PATHS --
# and refused when it reaches further. Set this only for a trusted, private
# server: it accepts any path asked.
LITTLE_AGENT_A2A_ALLOW_ANY_PATH=false
