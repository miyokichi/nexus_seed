{
  "tools": [
    {
      "name": "read_ppt",
      "description": "Extract text from a .pptx presentation inside the workspace.",
      "script": "scripts/ppt_file.py",
      "requires_confirmation": false,
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Workspace-relative .pptx path." },
          "max_slides": { "type": "integer", "description": "Maximum slides to read.", "default": 50 }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "write_ppt",
      "description": "Create a simple .pptx presentation from slide titles and bullets.",
      "script": "scripts/ppt_file.py",
      "requires_confirmation": true,
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Workspace-relative .pptx output path." },
          "slides": {
            "type": "array",
            "description": "Slides as objects with title and bullets.",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "bullets": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "required": ["path", "slides"],
        "additionalProperties": false
      }
    }
  ]
}
