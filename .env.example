# このファイルを .env として使用します。実際のkeyやtokenはcommitしないでください。
# `nexus-seed config`で、secretを表示せずに解決済み設定を確認できます。


# ---------------------------------------------------------------------------
# 1. Application Runtime
# ---------------------------------------------------------------------------

# 空欄の場合は ~/.nexus_seed を使用します。明示する場合はrepositoryの外を指定します。
NEXUS_SEED_DATA_DIR=

NEXUS_SEED_WEBHOOK_HOST=127.0.0.1
NEXUS_SEED_WEBHOOK_PORT=8787
# localhostでも設定を推奨します。localhost以外でlistenする場合は必須です。
NEXUS_SEED_WEBHOOK_TOKEN=change-this-token

NEXUS_SEED_TICK_SECONDS=1
NEXUS_SEED_LOG_LEVEL=INFO
NEXUS_SEED_OPERATOR_ID=local-operator
NEXUS_SEED_COCKPIT_ENABLED=true

# 永続的な Observation -> Knowledge -> Project -> Agent -> Knowledge loop。
NEXUS_SEED_KNOWLEDGE_LOOP_ENABLED=true
NEXUS_SEED_KNOWLEDGE_POLL_SECONDS=60


# ---------------------------------------------------------------------------
# 2. NEXUS SEED自身の推論model（任意）
# ---------------------------------------------------------------------------

# routing、状況評価、質問応答に使用するmodelです。
# 外部Project Agentが使用するmodelとは別の設定です。
NEXUS_SEED_LLM_ENABLED=false

# provider: anthropic | openai_compatible
NEXUS_SEED_LLM_PROVIDER=anthropic
NEXUS_SEED_LLM_MODEL=claude-sonnet-4-5
# 空欄ならproviderの既定URLを使用します。openai_compatibleでは設定が必須です。
NEXUS_SEED_LLM_BASE_URL=
NEXUS_SEED_LLM_MAX_TOKENS=8192
NEXUS_SEED_LLM_TIMEOUT_SECONDS=120

# keyそのものではなく、keyを保持する環境変数名を指定します。
NEXUS_SEED_LLM_API_KEY_ENV=ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# OpenAI互換serverを使用する場合の例:
# NEXUS_SEED_LLM_PROVIDER=openai_compatible
# NEXUS_SEED_LLM_BASE_URL=http://127.0.0.1:1234/v1
# NEXUS_SEED_LLM_MODEL=local-model
# NEXUS_SEED_LLM_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=local-server-key


# ---------------------------------------------------------------------------
# 3. Project Agent Runtime
# ---------------------------------------------------------------------------

# in_process = 制限付きのlocal runtime
# a2a        = 独自のmodelとSkillsを持つ外部Agent Runtime
NEXUS_SEED_PROJECT_AGENT_RUNTIME=in_process

# runtime=a2aの場合のみ必須です。
NEXUS_SEED_PROJECT_AGENT_URL=http://127.0.0.1:8801
# A2A bearer tokenを保持する環境変数名を任意で指定します。
NEXUS_SEED_PROJECT_AGENT_TOKEN_ENV=

NEXUS_SEED_PROJECT_AGENT_TIMEOUT_SECONDS=900
NEXUS_SEED_PROJECT_AGENT_POLL_SECONDS=2
NEXUS_SEED_PROJECT_AGENT_REQUEST_TIMEOUT_SECONDS=30

# workspace rootは任意です。Projectごとに子directoryを1つ作成します。
NEXUS_SEED_PROJECT_WORKSPACE=


# ---------------------------------------------------------------------------
# 4. Resource許可policy（既定では閉じています）
# ---------------------------------------------------------------------------

# rootの区切りはWindowsでは ";"、Unixでは ":" です。
# 空欄の場合、Project workspace外のhost fileは許可できません。
NEXUS_SEED_PROJECT_RESOURCE_READ_ROOTS=

# write可能なrootはread可能な範囲にも含めてください。read権限はwrite権限を含みません。
# write対象fileはstageされ、review境界を通過した後に回収されます。
NEXUS_SEED_PROJECT_RESOURCE_WRITE_ROOTS=


# ---------------------------------------------------------------------------
# 5. Semantica Knowledge（任意）
# ---------------------------------------------------------------------------

# Canonical YAMLを投入したfile-backed snapshot。repository外を推奨します。
NEXUS_SEED_SEMANTICA_SNAPSHOT=

# 会社固有typeを追加可能な小さなOntology YAMLです。
NEXUS_SEED_SEMANTICA_ONTOLOGY=
