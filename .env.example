# NEXUS SEED configuration.  Copy this file to .env.
#
# Two different language models are involved in a running system, and their
# settings look alike.  They are not the same thing:
#
#   (1) NEXUS SEED's own reasoning  -> NEXUS_SEED_LLM_*
#       The model NEXUS SEED thinks with: routing a message to a Project,
#       answering a question about one, interpreting an Event, choosing a plan.
#
#   (2) The model that does the work -> NOT CONFIGURED HERE
#       A Project is delegated whole to a Project Agent.  That Agent brings its
#       own model, its own keys and its own config file.  NEXUS_SEED_PROJECT_AGENT_*
#       below says *where* the Agent is, never *what it thinks with*.
#
# `nexus-seed config` prints the resolved settings in these same groups, so you
# can see which is which without reading this file.
#
# API keys are named by the variable that holds them, never written into the
# database.  Do not commit a real key.


# ---------------------------------------------------------------------------
# 1. NEXUS SEED's own reasoning — the model NEXUS SEED thinks with
# ---------------------------------------------------------------------------
# With this off NEXUS SEED still runs: it cannot judge what a message means, so
# it explains rather than delegates unless the message plainly asks for action.
NEXUS_SEED_LLM_ENABLED=false
# anthropic | openai_compatible.  LM Studio: http://127.0.0.1:1234/v1
#                                 Ollama:    http://127.0.0.1:11434/v1
NEXUS_SEED_LLM_PROVIDER=openai_compatible
NEXUS_SEED_LLM_BASE_URL=http://127.0.0.1:1234/v1
NEXUS_SEED_LLM_MODEL=local-model
NEXUS_SEED_LLM_MAX_TOKENS=8192
NEXUS_SEED_LLM_TIMEOUT_SECONDS=120
# The NAME of the variable holding the key, not the key.
NEXUS_SEED_LLM_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# 2. Skills — where NEXUS SEED looks for the procedures it can offer
# ---------------------------------------------------------------------------
# Offered to whoever executes: a Project Agent, an A2A provider.  Highest
# precedence first; separator is ";" on Windows and ":" elsewhere.
# Unset means ./skills then ~/.nexus_seed/skills.
NEXUS_SEED_SKILL_ROOTS=
# true stops the load on a broken Skill package instead of skipping it.
NEXUS_SEED_SKILLS_STRICT=false
# override | error — what to do when two roots define the same Skill name.
NEXUS_SEED_SKILLS_ON_DUPLICATE=override


# ---------------------------------------------------------------------------
# 3. Delegation — WHERE a Project is handed over (not what model does it)
# ---------------------------------------------------------------------------
# Route ordinary requests (nexus-seed task, webhooks, connectors) into Projects.
NEXUS_SEED_PROJECT_ORCHESTRATOR_ENABLED=false
# in_process = deterministic and network-free; it calls no model at all.
# a2a       = delegate each whole Project to an external Agent Runtime, which
#             supplies its own model.
NEXUS_SEED_PROJECT_AGENT_RUNTIME=in_process
NEXUS_SEED_PROJECT_AGENT_URL=http://127.0.0.1:8801
# The NAME of the variable holding the Agent's bearer token, not the token.
NEXUS_SEED_PROJECT_AGENT_TOKEN_ENV=
# A Project Agent owns a whole goal, so it gets far longer than one Skill call.
NEXUS_SEED_PROJECT_AGENT_TIMEOUT_SECONDS=900
NEXUS_SEED_PROJECT_AGENT_POLL_SECONDS=2
NEXUS_SEED_PROJECT_AGENT_REQUEST_TIMEOUT_SECONDS=30
# One directory per project, handed to the Agent.  Keep it relative unless the
# Agent Runtime can really write the absolute path.
NEXUS_SEED_PROJECT_WORKSPACE=


# ---------------------------------------------------------------------------
# 4. A2A provider federation — individual Skills executed elsewhere
# ---------------------------------------------------------------------------
# Separate from (3): that delegates a whole Project, this delegates one Skill.
NEXUS_SEED_A2A_ENABLED=false
NEXUS_SEED_A2A_CONFIG=./a2a.json
LITTLE_AGENT_TOKEN=


# ---------------------------------------------------------------------------
# 5. The process itself
# ---------------------------------------------------------------------------
NEXUS_SEED_DATA_DIR=
NEXUS_SEED_WEBHOOK_HOST=127.0.0.1
NEXUS_SEED_WEBHOOK_PORT=8787
NEXUS_SEED_WEBHOOK_TOKEN=change-this-token
NEXUS_SEED_TICK_SECONDS=1
NEXUS_SEED_LOG_LEVEL=INFO
# Recorded as the actor on review decisions and self-question answers.
NEXUS_SEED_OPERATOR_ID=local-operator
# The Web UI, served at /cockpit on the same authenticated listener.
NEXUS_SEED_COCKPIT_ENABLED=true
NEXUS_SEED_PHASE6_ENABLED=true
