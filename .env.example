# NEXUS SEEDの設定ファイルです。このファイルを.envへコピーして使用してください。
#
# 実行中のシステムでは、役割の異なる2種類の言語モデルを扱います。
# 設定は似ていますが、同じものではありません。
#
#   (1) NEXUS SEED自身の推論モデル -> NEXUS_SEED_LLM_*
#       メッセージのProjectへの振り分け、Projectに関する質問への回答、
#       Knowledgeの評価やProjectの振り分けなどに使用します。
#
#   (2) 実際の作業を行うモデル
#       実際のA2A Project Agentは、独自のモデル、キー、Skills、設定を使用します。
#       暫定的な制限付きin-process Agentは(1)を再利用し、Projectの根拠とcontextだけを
#       読み取ります。toolやファイルを直接操作する権限はありません。
#
# `nexus-seed config`を実行すると、解決済みの設定が同じ分類で表示されます。
# このファイルを読まなくても、それぞれの役割を確認できます。
#
# APIキーには、キーそのものではなく格納先の環境変数名を指定します。
# APIキーはデータベースへ保存されません。実際のキーをcommitしないでください。


# ---------------------------------------------------------------------------
# 1. NEXUS SEED自身の推論 — NEXUS SEEDが思考に使用するモデル
# ---------------------------------------------------------------------------
# falseでもNEXUS SEED自体は動作します。ただしメッセージの意味を判断できないため、
# 明確に実行を依頼された場合を除き、Agentへ委譲せず説明を返します。
NEXUS_SEED_LLM_ENABLED=false
# anthropic | openai_compatible.  LM Studio: http://127.0.0.1:1234/v1
#                                 Ollama:    http://127.0.0.1:11434/v1
NEXUS_SEED_LLM_PROVIDER=openai_compatible
NEXUS_SEED_LLM_BASE_URL=http://127.0.0.1:1234/v1
NEXUS_SEED_LLM_MODEL=local-model
NEXUS_SEED_LLM_MAX_TOKENS=8192
NEXUS_SEED_LLM_TIMEOUT_SECONDS=120
# キーそのものではなく、キーを格納している環境変数の名前を指定します。
NEXUS_SEED_LLM_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# 2. 委譲先 — Projectを「どこへ」渡すか（使用するモデルの指定ではありません）
# ---------------------------------------------------------------------------
# 通常の依頼（nexus-seed task、webhook、connector）は常にProjectへ振り分けます。
# in_process = localで動作する制限付きAgentです。NEXUS_SEED_LLM_*が有効なら再利用し、
#              無効なら安全に人間へ確認を求めます。
# a2a        = Project全体を外部のAgent Runtimeへ委譲します。
#              外部Runtimeは独自のモデルとSkillsを使用します。
NEXUS_SEED_PROJECT_AGENT_RUNTIME=in_process
NEXUS_SEED_PROJECT_AGENT_URL=http://127.0.0.1:8801
# Agentのbearer tokenそのものではなく、それを格納する環境変数名を指定します。
NEXUS_SEED_PROJECT_AGENT_TOKEN_ENV=
# Project AgentはGoal全体を担当するため、単一のSkill呼び出しより長い制限時間を設定します。
NEXUS_SEED_PROJECT_AGENT_TIMEOUT_SECONDS=900
NEXUS_SEED_PROJECT_AGENT_POLL_SECONDS=2
NEXUS_SEED_PROJECT_AGENT_REQUEST_TIMEOUT_SECONDS=30
# Projectごとに1つのdirectoryをAgentへ渡します。Agent Runtimeが絶対pathへ実際に
# 書き込める場合を除き、相対pathを指定してください。
NEXUS_SEED_PROJECT_WORKSPACE=

# Projectへ渡すことを許可するhost上のdirectory (区切りはWindowsなら ";"、それ以外は ":")。
# 空のままなら、workspace以外のhost上のfileは一切渡せません。NEXUS SEEDは
# Agentへホスト全体を無条件で公開しません。この範囲の中から、Projectごとに
# 何をreadable/writableにするかを明示的に許可します。
NEXUS_SEED_PROJECT_RESOURCE_READ_ROOTS=
# そのうち、書き込みも許可するdirectory。読めることは書けることを意味しないため、
# 別のlistになっています。
NEXUS_SEED_PROJECT_RESOURCE_WRITE_ROOTS=

# 用語・Goal・現状を自然文で書くbootstrap contextは NEXUS_SEED_DATA_DIR/context/ に
# 作成されます（terms.md / goals.md / situation.md）。設定項目はありません。
# 書いた原文がそのまま保持され、schemaへは変換されません。
#
# 永続的な 観測 -> Knowledge -> Project -> Agent -> Knowledge のloopを動かします。
# 読み取りを許可するlocal inboxはNEXUS_SEED_DATA_DIR/resourcesだけです。
# それ以外のuser directoryは読み取りません。
# PC環境の観測元は自動作成されません。CockpitのWorld画面で、OS・ホスト名・CPU・
# メモリ・NEXUS_SEED_DATA_DIRの使用量から必要な項目だけを明示的に登録します。
NEXUS_SEED_KNOWLEDGE_LOOP_ENABLED=true
NEXUS_SEED_KNOWLEDGE_POLL_SECONDS=60


# ---------------------------------------------------------------------------
# 3. NEXUS SEED process自体の設定
# ---------------------------------------------------------------------------
NEXUS_SEED_DATA_DIR=
NEXUS_SEED_WEBHOOK_HOST=127.0.0.1
NEXUS_SEED_WEBHOOK_PORT=8787
NEXUS_SEED_WEBHOOK_TOKEN=change-this-token
NEXUS_SEED_TICK_SECONDS=1
NEXUS_SEED_LOG_LEVEL=INFO
# 成果物・完了・Entityなどの判断を行ったactorとして記録されます。
NEXUS_SEED_OPERATOR_ID=local-operator
# 同じ認証済みlistenerの/cockpitで提供されるWeb UIです。
NEXUS_SEED_COCKPIT_ENABLED=true
