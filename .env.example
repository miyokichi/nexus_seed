# OpenAI-compatible local LLM. Copy this file to .env.
# LM Studio: http://127.0.0.1:1234/v1
# Ollama:    http://127.0.0.1:11434/v1
NEXUS_SEED_DATA_DIR=
NEXUS_SEED_WEBHOOK_HOST=127.0.0.1
NEXUS_SEED_WEBHOOK_PORT=8787
NEXUS_SEED_WEBHOOK_TOKEN=change-this-token
NEXUS_SEED_TICK_SECONDS=1
NEXUS_SEED_LOG_LEVEL=INFO
# Authenticated principal used by the local /control HTTP endpoint.
NEXUS_SEED_CONTROL_IDENTITY=local-operator
# Comma-separated grants. Narrow these for shared/remote deployments.
NEXUS_SEED_CONTROL_PERMISSIONS=command.*
# Human Cockpit is served at /cockpit on the same authenticated HTTP listener.
NEXUS_SEED_COCKPIT_ENABLED=true

# Phase 6 Persistent Being is on by default. false restores Phase 5G behavior.
NEXUS_SEED_PHASE6_ENABLED=true

# External Agent Runtime (A2A). Cognitive Skills are delegated over HTTP to a
# separate agent process; NEXUS SEED keeps durability, the agent does the LLM
# work. See a2a.example.json.
NEXUS_SEED_A2A_ENABLED=false
NEXUS_SEED_A2A_CONFIG=./a2a.json
# Skill roots, highest precedence first. Overridden by "skills.roots" in the
# A2A config. Separator is ";" on Windows and ":" elsewhere.
NEXUS_SEED_SKILL_ROOTS=
# Optional bearer token for an A2A agent that requires one.
LITTLE_AGENT_TOKEN=

# Project Agent for `nexus-seed project`. "in_process" is the deterministic
# runtime; "a2a" delegates each whole Project to an external Agent Runtime.
NEXUS_SEED_PROJECT_AGENT_RUNTIME=in_process
NEXUS_SEED_PROJECT_AGENT_URL=http://127.0.0.1:8801
# Name of the environment variable holding a bearer token, never the token.
NEXUS_SEED_PROJECT_AGENT_TOKEN_ENV=
# A Project Agent owns a whole Goal, so it gets far longer than one Skill call.
NEXUS_SEED_PROJECT_AGENT_TIMEOUT_SECONDS=900
NEXUS_SEED_PROJECT_AGENT_POLL_SECONDS=2
# Workspace handed to a Project Agent, one directory per project. Keep it
# relative unless the Agent Runtime can really write the absolute path.
NEXUS_SEED_PROJECT_WORKSPACE=

NEXUS_SEED_LLM_ENABLED=false
NEXUS_SEED_LLM_PROVIDER=openai_compatible
NEXUS_SEED_LLM_BASE_URL=http://127.0.0.1:1234/v1
NEXUS_SEED_LLM_MODEL=local-model
NEXUS_SEED_LLM_MAX_TOKENS=8192
NEXUS_SEED_LLM_TIMEOUT_SECONDS=120
NEXUS_SEED_LLM_API_KEY_ENV=OPENAI_API_KEY
# Optional. Never commit a real key.
OPENAI_API_KEY=
